[Unit]
Description=Inertia Creations Next.js site
After=network.target

[Service]
Type=simple
User=inertia
Group=inertia
WorkingDirectory=/var/www/inertia
Environment=NODE_ENV=production
Environment=PORT=3060
EnvironmentFile=/var/www/inertia/.env.production.local
ExecStart=/usr/bin/npm start -- -p 3060
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
