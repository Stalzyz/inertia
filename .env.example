# Canonical URL used for metadata, Open Graph, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://inertiacreations.com

# Studio admin — required to sign in at /admin.
# Use a long, unique password. Changing it invalidates all existing sessions.
ADMIN_PASSWORD=

# Contact delivery — choose ONE of the two options below.
# Option A: any CRM / automation webhook that accepts JSON.
CONTACT_WEBHOOK_URL=https://garage.grekam.in/api/v1/crm/public/leads/inertiacreation

# Option B: Resend email delivery.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
